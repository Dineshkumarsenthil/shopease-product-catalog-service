# Database (MYSQL_HOST is overridden to the compose service name inside Docker)
MYSQL_HOST=localhost
MYSQL_PORT=3309
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=shopease_product_catalog_db

# JWT - these must match the Authentication Service
JWT_SECRET_KEY=same_secret_as_auth_service
JWT_ALGORITHM=HS256
JWT_USER_ID_CLAIM=sub
JWT_ROLE_CLAIM=role
ADMIN_ROLE=admin

# Inventory
LOW_STOCK_THRESHOLD=10
